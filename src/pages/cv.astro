---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/profile';
import StatusBadge from '../components/StatusBadge.astro';

const certificates = [
  { name: 'Nghiệp vụ Tư vấn tâm lý học đường', date: '09/11/2021', issuer: 'Trường ĐH Khoa học Xã hội và Nhân văn - ĐHQG TP.HCM', grade: 'Xuất sắc' },
  { name: 'Chứng chỉ Tin học', date: '04/07/2018', issuer: 'Trường ĐH Khoa học Xã hội và Nhân văn - ĐHQG TP.HCM', grade: 'Giỏi' },
  { name: 'Chứng chỉ Photoshop', date: '', issuer: 'Trường ĐH Kinh tế - Tài chính TP.HCM', grade: '' },
  { name: 'Chứng chỉ Ứng dụng Công nghệ thông tin cơ bản', date: '', issuer: 'Trường ĐH Kinh tế - Tài chính TP.HCM', grade: '' },
];
---

<BaseLayout title={`CV ${profile.name} | Academic Support and Educational Psychology`} description="Hồ sơ năng lực trực tuyến của Trịnh Gia Khiêm.">
  <div class="container content-wrapper page-section cv-page">

    <div class="cv-header no-print">
      <SectionHeading title="Curriculum Vitae" subtitle="Hồ sơ nghề nghiệp" align="left" />
      <div class="cv-actions">
        <a href={`${import.meta.env.BASE_URL}docs/cv.pdf`} class="btn btn-primary" download>Tải CV PDF</a>
        <button class="btn btn-secondary" onclick="window.print()">In CV</button>
      </div>
    </div>

    <!-- Nội dung bản CV chính (hiển thị khi in) -->
    <div class="cv-document">
      <header class="cv-doc-header">
        <h1>{profile.name}</h1>
        <p class="cv-doc-subtitle">Academic Support • Educational Psychology • English Language Education • AI in Education</p>
        <ul class="cv-contact">
          <li><strong>Email:</strong> <a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><strong>Điện thoại:</strong> <a href={`tel:${profile.phone}`}>{profile.phone}</a></li>
          <li><strong>Website:</strong> <a href={profile.website}>trinhgiakhiem.info.vn</a></li>
        </ul>
      </header>

      <section class="cv-doc-summary mt-6">
        <p>Có chuyên ngành về Tâm lý Giáo dục và Tiếng Anh, 8 năm công tác trong lĩnh vực giáo dục. Có kỹ năng và kinh nghiệm về tư vấn, giảng dạy, công nghệ AI, công việc văn phòng, giải quyết vấn đề và chăm sóc người học trong lĩnh vực giáo dục. Có khả năng ứng dụng công nghệ thông tin và AI để giảm thời gian, công sức, tăng năng suất và chất lượng công việc. Mục tiêu: cống hiến cho Giáo dục, Chăm sóc sức khỏe tinh thần và Giảng dạy.</p>
      </section>

      <div class="cv-doc-body mt-8">
        <aside class="cv-doc-sidebar">

          <section class="cv-doc-section">
            <h3 class="section-title">Kỹ năng chuyên môn</h3>
            <ul class="clean-list skill-tags">
              <li>Tư vấn, tham vấn</li>
              <li>Hỗ trợ sinh viên</li>
              <li>Giảng dạy, đào tạo</li>
              <li>Truyền thông giáo dục</li>
            </ul>
          </section>

          <section class="cv-doc-section mt-6">
            <h3 class="section-title">Kỹ năng mềm</h3>
            <ul class="clean-list skill-tags">
              <li>Giải quyết vấn đề</li>
              <li>Thuyết trình</li>
              <li>Giao tiếp</li>
              <li>Làm việc nhóm</li>
            </ul>
          </section>

          <section class="cv-doc-section mt-6">
            <h3 class="section-title">Công cụ</h3>
            <div class="tool-group">
              <strong>Tin học văn phòng:</strong>
              <span>Microsoft Word, Excel, PowerPoint</span>
            </div>
            <div class="tool-group mt-2">
              <strong>Công nghệ &amp; AI:</strong>
              <span>ChatGPT, Claude, Gemini, Antigravity, OpenClaw, Google Apps Script</span>
            </div>
            <div class="tool-group mt-2">
              <strong>Dữ liệu:</strong>
              <span>Zoho CRM, Edusoft, Excel, Access</span>
            </div>
            <div class="tool-group mt-2">
              <strong>Thiết kế:</strong>
              <span>Adobe Photoshop, Canva</span>
            </div>
          </section>

          <section class="cv-doc-section mt-6">
            <h3 class="section-title">Ngôn ngữ</h3>
            <ul class="clean-list">
              <li><strong>Tiếng Việt:</strong> Ngôn ngữ chính</li>
              <li><strong>Tiếng Anh:</strong> Cử nhân Ngôn ngữ Anh, đang học Thạc sĩ</li>
            </ul>
          </section>

          <section class="cv-doc-section mt-6 no-print">
            <h3 class="section-title">Liên kết</h3>
            <ul class="clean-list">
              <li><a href="/du-an">Dự án giáo dục</a></li>
              <li><a href="/nghien-cuu">Khám phá nghiên cứu</a></li>
              <li><a href="/lien-he">Thông tin liên hệ</a></li>
            </ul>
          </section>

        </aside>

        <main class="cv-doc-main">

          <section class="cv-doc-section">
            <h3 class="section-title">Học vấn</h3>

            <div class="timeline-item">
              <div class="timeline-meta">2025 - Nay</div>
              <h4 class="timeline-title">Thạc sĩ Ngôn ngữ Anh</h4>
              <div class="timeline-subtitle">Trường Đại học Kinh tế - Tài chính TP.HCM (UEF)</div>
              <p class="timeline-status">Trạng thái: Đang theo học</p>
            </div>

            <div class="timeline-item">
              <div class="timeline-meta">2022 - 2024</div>
              <h4 class="timeline-title">Cử nhân Ngôn ngữ Anh</h4>
              <div class="timeline-subtitle">Trường Đại học Kinh tế - Tài chính TP.HCM (UEF)</div>
            </div>

            <div class="timeline-item">
              <div class="timeline-meta">2017 - 2021</div>
              <h4 class="timeline-title">Cử nhân Tâm lý Giáo dục</h4>
              <div class="timeline-subtitle">Trường Đại học Khoa học Xã hội và Nhân văn - ĐHQG TP.HCM</div>
            </div>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Chứng chỉ</h3>
            <ul class="cert-list">
              {certificates.map((c) => (
                <li>
                  <strong>{c.name}</strong>
                  {c.grade && <span class="cert-grade">{c.grade}</span>}
                  <div class="cert-meta">{c.issuer}{c.date && ` · ${c.date}`}</div>
                </li>
              ))}
            </ul>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Quá trình công tác</h3>

            <div class="timeline-item">
              <div class="timeline-meta">2/2022 - Nay</div>
              <h4 class="timeline-title">Trường Đại học Kinh tế - Tài chính TP.HCM (UEF)</h4>
              <div class="timeline-subtitle">Nhân viên Trung tâm Hỗ trợ học vụ · Tổ trưởng Tổ Truyền thông học vụ (từ 2025)</div>
              <p>Thực hiện nhiệm vụ thông tin - truyền thông, phòng ngừa và giải quyết vấn đề, tư vấn, chăm sóc, hỗ trợ sinh viên/phụ huynh về học tập và học vụ.</p>
            </div>

            <div class="timeline-item">
              <div class="timeline-meta">9/2020 - 6/2021</div>
              <h4 class="timeline-title">Trung tâm Đào tạo Kỹ năng sống Ý Tưởng Việt</h4>
              <div class="timeline-subtitle">Giáo viên Kỹ năng sống</div>
              <p>Giảng dạy kỹ năng sống cho học sinh cấp 1, cấp 2 tại một số trường trên địa bàn TP.HCM.</p>
            </div>

            <div class="timeline-item">
              <div class="timeline-meta">9/2018 - 6/2019</div>
              <h4 class="timeline-title">Trường Tiểu học Lê Ngọc Hân (Quận 1, TP.HCM)</h4>
              <div class="timeline-subtitle">Phó Tổng phụ trách Đội</div>
              <p>Quản lý, thực hiện công tác Đội TNTP và phong trào thiếu nhi trong trường.</p>
            </div>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Kinh nghiệm</h3>

            <div class="timeline-item">
              <h4 class="timeline-title">Tư vấn, chăm sóc, hỗ trợ sinh viên</h4>
              <ul class="bullet-list">
                <li>Tư vấn trực tiếp và trực tuyến qua Facebook, Zalo, Email và Điện thoại tại Trung tâm Hỗ trợ học vụ UEF.</li>
                <li>Tiếp nhận, xử lý và theo dõi hồ sơ học vụ; hướng dẫn quy trình, quy định đào tạo.</li>
                <li>Hỗ trợ phụ huynh và sinh viên trong suốt quá trình học tập.</li>
              </ul>
            </div>

            <div class="timeline-item">
              <h4 class="timeline-title">Thiết kế, Thông tin - Truyền thông</h4>
              <ul class="bullet-list">
                <li>Tổ trưởng Tổ Truyền thông - Thông tin, Trung tâm Hỗ trợ học vụ UEF: thiết kế ấn phẩm, viết tin bài Website và Fanpage; quản lý hệ thống email; triển khai Email (Outlook, Zoho Campaign), SMS-ZNS và các kênh truyền thông học vụ.</li>
                <li>Thành lập Đội Truyền thông EMT và xây dựng Fanpage Đoàn - Hội Khoa Giáo dục (ĐH KHXH&amp;NV); phụ trách toàn bộ hoạt động truyền thông.</li>
                <li>Trưởng Ban Truyền thông Xuân tình nguyện Khoa Giáo dục 2019 và nhiều chương trình của Đoàn - Hội.</li>
              </ul>
            </div>

            <div class="timeline-item">
              <h4 class="timeline-title">Dữ liệu</h4>
              <ul class="bullet-list">
                <li>Quản lý dữ liệu sinh viên và chăm sóc sinh viên (xử lý, lưu trữ, truy xuất) trên Zoho CRM, Edusoft, Excel, Access.</li>
                <li>Xử lý dữ liệu, phát hiện đối tượng cần chăm sóc và thực hiện chăm sóc.</li>
              </ul>
            </div>

            <div class="timeline-item">
              <h4 class="timeline-title">Giảng dạy</h4>
              <ul class="bullet-list">
                <li>Giáo viên Kỹ năng sống: giảng dạy kỹ năng sống cho học sinh tiểu học và trung học cơ sở tại nhiều trường ở TP.HCM.</li>
                <li>Phó Tổng phụ trách Đội: hướng dẫn kỹ năng Đội, nghi thức Đội và tổ chức hoạt động trải nghiệm cho học sinh.</li>
              </ul>
            </div>

            <div class="timeline-item">
              <h4 class="timeline-title">Chương trình sự kiện - Phong trào</h4>
              <ul class="bullet-list">
                <li>Liên chi Hội Sinh viên Khoa Giáo dục (ĐH KHXH&amp;NV): Liên chi Hội phó; Ban Tổ chức Xuân tình nguyện, Trung thu yêu thương, Thu gom rác - Bảo vệ môi trường, Lễ Tri ân - Trưởng thành, Chào đón Tân sinh viên, Hội trại truyền thống.</li>
                <li>Nhóm Sinh viên Công giáo Tu đoàn Thiên Phúc: Trưởng Ban Tổ chức sự kiện; Hội trại Xuân, Hát cho nhau nghe và các hoạt động cộng đồng.</li>
                <li>Trường Tiểu học Lê Ngọc Hân: Ban Tổ chức Sinh hoạt đầu tuần, Hội chợ Xuân, Hội thi Chỉ huy Đội giỏi và các hoạt động ngoài giờ lên lớp.</li>
              </ul>
            </div>

            <div class="timeline-item">
              <h4 class="timeline-title">Hành chính văn phòng &amp; Quản lý</h4>
              <ul class="bullet-list">
                <li>Quản lý Email Trung tâm Hỗ trợ học vụ: tiếp nhận, xử lý, phản hồi, lưu trữ và theo dõi email; công tác văn thư, công văn đi - đến.</li>
                <li>Tổ trưởng Tổ Truyền thông học vụ, Trung tâm Hỗ trợ học vụ UEF.</li>
                <li>Sáng lập và là đội trưởng đầu tiên của Đội Truyền thông Đoàn - Hội Khoa Giáo dục EMT.</li>
              </ul>
            </div>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Thành tích</h3>
            <ul class="bullet-list">
              <li>Nhân viên xuất sắc Trung tâm Hỗ trợ học vụ - Phòng Đào tạo, Trường ĐH Kinh tế - Tài chính TP.HCM các năm học 2022-2023, 2023-2024, 2024-2025.</li>
              <li>Chiến sĩ thi đua cơ sở Trường ĐH Kinh tế - Tài chính TP.HCM các năm học 2022-2023, 2023-2024, 2024-2025.</li>
              <li>Quý quân Hùng biện Tiếng nói Thanh niên “Hành động vì một thành phố phát triển”.</li>
              <li>Giấy khen Khoa Giáo dục: Cá nhân có thành tích xuất sắc trong hoạt động phong trào 2017-2018.</li>
              <li>Giấy khen Hội Sinh viên Trường: thành tích xuất sắc trong công tác Hội và phong trào sinh viên 2017-2018, 2018-2019 và giai đoạn 2016-2019.</li>
              <li>Giấy khen Hội Sinh viên Trường: Chiến sĩ xuất sắc Xuân Tình Nguyện 2019.</li>
            </ul>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Nghiên cứu</h3>
            <div class="timeline-item">
              <StatusBadge status="Đang thực hiện" />
              <h4 class="timeline-title mt-2">Vietnamese teachers’ attitudes toward using AI tools for corrective feedback on their students’ English writing</h4>
            </div>
          </section>

          <section class="cv-doc-section mt-8">
            <h3 class="section-title">Dự án</h3>
            <ul class="bullet-list">
              <li>Website khảo sát và nguồn lực hỗ trợ sinh viên</li>
              <li>Góc kỹ năng và phương pháp học tập</li>
              <li>Truyền thông học vụ</li>
              <li>Tự động hóa hỗ trợ công việc</li>
            </ul>
          </section>

        </main>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-section {
    padding: var(--space-12) var(--space-4);
  }
  
  .mt-2 { margin-top: var(--space-2); }
  .mt-6 { margin-top: var(--space-6); }
  .mt-8 { margin-top: var(--space-8); }
  
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-12);
  }
  
  .cv-actions {
    display: flex;
    gap: var(--space-4);
  }
  
  /* CV Document Design */
  .cv-document {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  .cv-doc-header h1 {
    font-size: 2.5rem;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-pink-light);
    padding-bottom: var(--space-4);
  }
  
  .cv-doc-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    font-weight: 500;
  }
  
  .cv-doc-summary {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-main);
  }
  
  .cv-doc-body {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    gap: var(--space-12);
  }
  
  .section-title {
    font-size: 1.25rem;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .clean-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .clean-list li {
    margin-bottom: var(--space-2);
  }
  
  .bullet-list {
    padding-left: 1.25rem;
    margin: 0;
  }
  
  .bullet-list li {
    margin-bottom: var(--space-2);
    line-height: 1.5;
  }
  
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .skill-tags li {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    background-color: var(--color-pink-light);
    color: var(--color-pink-dark);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }
  
  .tool-group span {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }
  
  .cv-contact {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .cv-contact strong {
    color: var(--color-text-main);
  }

  .cv-contact a {
    color: inherit;
    overflow-wrap: anywhere;
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cert-list li {
    margin-bottom: var(--space-4);
  }

  .cert-grade {
    display: inline-block;
    margin-left: var(--space-2);
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    background-color: var(--color-pink-light);
    color: var(--color-pink-dark);
    border-radius: var(--radius-sm);
    font-weight: 600;
    vertical-align: middle;
  }

  .cert-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .timeline-item p {
    line-height: 1.6;
    margin: 0;
  }

  /* Timeline Items */
  .timeline-item {
    margin-bottom: var(--space-6);
  }
  
  .timeline-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  
  .timeline-title {
    font-size: 1.125rem;
    color: var(--color-text-main);
    margin-bottom: 0.125rem;
  }
  
  .timeline-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-2);
  }
  
  .timeline-status {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  
  @media (max-width: 768px) {
    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }
    
    .cv-doc-body {
      grid-template-columns: 1fr;
    }
    
    .cv-document {
      padding: var(--space-6);
    }
  }
  
  /* Print Styles */
  @media print {
    :global(body) {
      background-color: white !important;
    }
    
    .no-print, :global(header), :global(footer) {
      display: none !important;
    }
    
    .page-section {
      padding: 0 !important;
    }
    
    .cv-document {
      border: none;
      box-shadow: none;
      padding: 0;
    }
    
    .cv-doc-body {
      gap: var(--space-8);
    }
    
    .skill-tags li {
      border: 1px solid var(--color-border);
      background-color: transparent;
      color: var(--color-text-main);
    }
    
    .section-title {
      color: #000;
      border-bottom: 1px solid #ddd;
      padding-bottom: 0.25rem;
    }
    
    a {
      text-decoration: none;
      color: inherit;
    }
  }
</style>
